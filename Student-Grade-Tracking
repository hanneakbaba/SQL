CREATE VIEW vw_StudentGradeStatus
AS
SELECT
    s.StudentNumber,
    s.FirstName + ' ' + s.LastName AS Student,
    c.CourseCode,
    c.CourseName,
    g.Semester,
    g.Midterm,
    g.FinalExam,
    (g.Midterm * 0.40 + g.FinalExam * 0.60) AS FinalGrade,

    CASE
        WHEN (g.Midterm * 0.40 + g.FinalExam * 0.60) >= 50
            THEN 'Passed'
        ELSE 'Failed'
    END AS Status

FROM Grades g
INNER JOIN Students s ON g.StudentId = s.StudentId
INNER JOIN Courses c ON g.CourseId = c.CourseId;
GO

