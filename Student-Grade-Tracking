CREATE DATABASE StudentGradeTrackingDB
GO

USE StudentGradeTrackingDB;
GO

CREATE TABLE Departments (
    DepartmentId INT IDENTITY(1,1) PRIMARY KEY,
    DepartmentName NVARCHAR(100) NOT NULL UNIQUE
)

CREATE TABLE Students (
    StudentId INT IDENTITY(1,1) PRIMARY KEY,
    StudentNumber VARCHAR(20) NOT NULL UNIQUE,
    FirstName NVARCHAR(50) NOT NULL,
    LastName NVARCHAR(50) NOT NULL,
    Email VARCHAR(150) UNIQUE,
    BirthDate DATE,
    DepartmentId INT NOT NULL,
    EnrollmentDate DATE DEFAULT GETDATE(),

    FOREIGN KEY (DepartmentId) REFERENCES Departments(DepartmentId)
)

CREATE TABLE Courses (
    CourseId INT IDENTITY(1,1) PRIMARY KEY,
    CourseCode VARCHAR(15) NOT NULL UNIQUE,
    CourseName NVARCHAR(100) NOT NULL,
    Credit TINYINT NOT NULL CHECK (Credit BETWEEN 1 AND 10),
    DepartmentId INT NOT NULL,

    FOREIGN KEY (DepartmentId) REFERENCES Departments(DepartmentId)
)

CREATE TABLE Grades (
    GradeId INT IDENTITY(1,1) PRIMARY KEY,
    StudentId INT NOT NULL,
    CourseId INT NOT NULL,
    Midterm DECIMAL(5,2) CHECK (Midterm BETWEEN 0 AND 100),
    FinalExam DECIMAL(5,2) CHECK (FinalExam BETWEEN 0 AND 100),
    Semester VARCHAR(15) NOT NULL,

    FOREIGN KEY (StudentId) REFERENCES Students(StudentId),
    FOREIGN KEY (CourseId) REFERENCES Courses(CourseId),

    UNIQUE (StudentId, CourseId, Semester)
)

