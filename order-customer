create table Payments
(
    PaymentID int primary key identity,
    OrderID int not null,
    PaymentType varchar(50) not null,
    PaymentDate datetime default getdate(),
    Amount decimal(10,2) not null,

    foreign key (OrderID)
        references Orders(OrderID)
)

